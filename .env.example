# Environment Variables Example
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for production (Vercel / Supabase / Neon / Railway):
# DATABASE_URL="postgresql://username:password@localhost:5432/aismm_db?schema=public"

JWT_SECRET="replace-with-a-random-secret-key"
TELEGRAM_BOT_USERNAME="aismm_assistant_bot"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
GEMINI_API_KEY="your_gemini_api_key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Meta / Instagram OAuth Credentials (from developers.facebook.com)
META_APP_ID="your_meta_app_id_here"
META_APP_SECRET="your_meta_app_secret_here"
# Meta Redirect URI:
# http://localhost:3000/api/auth/instagram/callback (local)
# https://your-domain.vercel.app/api/auth/instagram/callback (production)


